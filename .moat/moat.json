{
  "project_name": "textream-cn-master",
  "version": "2.0",
  "rules": {
    "layer_enforcement": {
      "enabled": true,
      "description": "禁止跨层调用（如 controller 直接调用 model）",
      "severity": "high"
    },
    "api_authentication": {
      "enabled": true,
      "description": "API 接口必须经过鉴权中间件",
      "severity": "critical",
      "auto_detect": true
    },
    "race_condition": {
      "enabled": true,
      "description": "检测 pendingMessageRef 等竞态条件",
      "severity": "high",
      "patterns": [
        "pendingMessageRef",
        "useEffect 缺少依赖"
      ]
    },
    "sql_injection": {
      "enabled": true,
      "description": "禁止直接拼接 SQL 字符串",
      "severity": "critical",
      "auto_detect": true
    },
    "error_handling": {
      "enabled": true,
      "description": "async 函数必须有 try/except",
      "severity": "medium",
      "auto_detect": true
    },
    "async_safety": {
      "enabled": true,
      "description": "检测同步函数中调用异步函数未 await",
      "severity": "high",
      "auto_detect": true
    },
    "import_completeness": {
      "enabled": true,
      "description": "检测导入的模块是否真实存在",
      "severity": "high",
      "auto_detect": true
    },
    "secret_detection": {
      "enabled": true,
      "description": "检测硬编码密钥和 API Token",
      "severity": "critical",
      "auto_detect": true
    },
    "dependency_security": {
      "enabled": true,
      "description": "检测依赖中的已知漏洞",
      "severity": "high",
      "auto_detect": true
    },
    "unused_exports": {
      "enabled": true,
      "description": "检测未使用的导出符号",
      "severity": "low",
      "auto_detect": true
    },
    "core_file_modification": {
      "enabled": true,
      "severity": "critical",
      "core_files": []
    }
  },
  "auto_detect": {
    "core_areas": true,
    "entry_points": true,
    "log_path": true,
    "api_endpoints": true,
    "architecture": true,
    "test_files": true
  },
  "log_path": "logs/backend.log",
  "filter_pattern": "ERROR|Traceback|Process exited|Exception",
  "check_on_commit": true,
  "auto_monitor": true,
  "monitor_interval": 30,
  "preflight": {
    "enabled": true,
    "auto_run": true,
    "files_auto_detect": true
  },
  "baseline": {
    "enabled": true,
    "auto_update": true,
    "compare_on_check": true
  },
  "evolution": {
    "enabled": true,
    "track_metrics": true,
    "auto_propose": false
  },
  "python": {
    "framework": "fastapi",
    "entry_points": [
      "agent/run_agent_v2.py",
      "agent/agent_core/server.py"
    ]
  },
  "typescript": {
    "framework": "react",
    "entry_points": [
      "web-console/src/main.tsx",
      "web-console/src/index.css"
    ]
  },
  "test_paths": [
    "tests/moat/",
    "agent/agent_core/"
  ],
  "adversarial_review": {
    "model": "deepseek-v4-flash",
    "base_url": "https://token.sensenova.cn/v1",
    "enabled": true,
    "pain_threshold": 75.0,
    "review_depth": "standard",
    "provider": "",
    "max_tokens": 4000,
    "timeout": 30,
    "enable_security_auditor": true,
    "enable_architect": true,
    "enable_concurrency_devil": true
  },
  "env_isolation": {
    "enabled": true,
    "check_interpreter": true,
    "check_dependency_drift": true,
    "check_dangerous_commands": true,
    "allowed_venv_names": [
      ".venv",
      "venv"
    ],
    "whitelist_packages": [
      "moat"
    ],
    "scan_exclude": [
      "node_modules",
      ".git",
      "dist",
      "build"
    ]
  }
}